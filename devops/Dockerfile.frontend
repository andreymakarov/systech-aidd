# Multi-stage build for Next.js frontend

# Stage 1: Dependencies
FROM node:20-alpine AS deps
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# Copy workspace configuration
COPY pnpm-workspace.yaml ./
COPY pnpm-lock.yaml ./

# Copy package.json from frontend workspace
COPY frontend/web/package.json ./frontend/web/package.json

# Install dependencies in workspace context
RUN pnpm install --frozen-lockfile

# Stage 2: Builder
FROM node:20-alpine AS builder
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# Copy workspace files
COPY pnpm-workspace.yaml ./

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/frontend/web/node_modules ./frontend/web/node_modules

# Copy frontend source
COPY frontend/web ./frontend/web

# Set environment for build
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Build Next.js app with standalone output
WORKDIR /app/frontend/web
RUN pnpm build

# Stage 3: Runner  
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy all necessary files from builder
COPY --from=builder --chown=nextjs:nodejs /app/pnpm-workspace.yaml ./
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/frontend/web/package.json ./frontend/web/
COPY --from=builder --chown=nextjs:nodejs /app/frontend/web/.next ./frontend/web/.next
COPY --from=builder --chown=nextjs:nodejs /app/frontend/web/next.config.mjs ./frontend/web/
COPY --from=builder --chown=nextjs:nodejs /app/frontend/web/node_modules ./frontend/web/node_modules

USER nextjs

WORKDIR /app/frontend/web

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Use Next.js start command instead of standalone
CMD ["pnpm", "start"]

